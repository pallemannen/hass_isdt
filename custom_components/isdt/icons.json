{
  "entity": {
    "binary_sensor": {
      "cell_inserted": {
        "default": "mdi:battery-outline",
        "state": {
          "off": "mdi:battery-off-outline"
        }
      }
    },
    "sensor": {
      "status": {
        "default": "mdi:battery-unknown",
        "state": {
          "empty": "mdi:battery-off-outline",
          "idle": "mdi:battery-outline",
          "pre_charge": "mdi:battery-charging-outline",
          "charging": "mdi:battery-charging-50",
          "charged": "mdi:battery-check",
          "rejected": "mdi:battery-remove",
          "unknown": "mdi:battery-unknown"
        }
      },
      "verdict": {
        "default": "mdi:battery-heart-variant",
        "state": {
          "checking": "mdi:battery-sync",
          "good": "mdi:battery-heart-variant",
          "worn": "mdi:battery-alert-variant-outline",
          "rejected": "mdi:battery-remove-outline",
          "possible_alkaline": "mdi:battery-alert",
          "shorted": "mdi:delete-alert"
        }
      },
      "charged_capacity": {
        "default": "mdi:battery-plus-variant"
      },
      "charging_since": {
        "default": "mdi:timer-play-outline"
      },
      "charging_time": {
        "default": "mdi:timer-outline"
      },
      "resistance": {
        "default": "mdi:omega"
      },
      "termination": {
        "default": "mdi:battery-check-outline",
        "state": {
          "voltage_limit": "mdi:arrow-collapse-up",
          "minus_delta_v": "mdi:trending-down",
          "zero_delta_v": "mdi:trending-neutral",
          "pre_charge_failed": "mdi:battery-alert-variant-outline"
        }
      },
      "total_current": {
        "default": "mdi:current-dc"
      },
      "slots": {
        "default": "mdi:battery-outline"
      },
      "free_slots": {
        "default": "mdi:battery-off-outline"
      },
      "cells_charging": {
        "default": "mdi:battery-charging"
      },
      "cells_charged": {
        "default": "mdi:battery-check"
      },
      "invalid_cells": {
        "default": "mdi:battery-alert"
      },
      "rejected_cells": {
        "default": "mdi:battery-remove"
      }
    },
    "event": {
      "charger_event": {
        "default": "mdi:bell-ring-outline",
        "state_attributes": {
          "event_type": {
            "default": "mdi:bell-ring-outline",
            "state": {
              "charged": "mdi:battery-check",
              "all_charged": "mdi:check-all",
              "remove_cell": "mdi:battery-alert",
              "long_charge": "mdi:timer-alert-outline"
            }
          }
        }
      }
    }
  }
}
